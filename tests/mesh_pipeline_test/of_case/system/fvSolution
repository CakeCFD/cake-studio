FoamFile
{ version 2.0; format ascii; class dictionary; object fvSolution; }

solvers
{
    p       { solver GAMG; smoother GaussSeidel; tolerance 1e-7; relTol 0.01; }
    pFinal  { $p; relTol 0; }
    U       { solver smoothSolver; smoother GaussSeidel; tolerance 1e-8; relTol 0.1; }
    "(k|omega|epsilon|nuTilda)" { solver smoothSolver; smoother GaussSeidel; tolerance 1e-8; relTol 0.1; }
}

SIMPLE
{
    nNonOrthogonalCorrectors 2;
    residualControl { p 1e-5; U 1e-5; }
}

relaxationFactors
{
    fields  { p 0.3; }
    equations { U 0.7; k 0.7; omega 0.7; epsilon 0.7; }
}
