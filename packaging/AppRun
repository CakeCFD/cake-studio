#!/bin/bash
HERE="$(dirname "$(readlink -f "${0}")")"

# Library and plugin paths from the AppDir
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="${HERE}/usr/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="${HERE}/usr/plugins/platforms"
export VTK_AUTOLOAD_PATH="${HERE}/usr/lib"

# Source OpenFOAM - required for the solver backend
OF_BASHRC="/usr/lib/openfoam/openfoam2412/etc/bashrc"
if [ -f "$OF_BASHRC" ]; then
    # shellcheck disable=SC1090
    source "$OF_BASHRC" 2>/dev/null
else
    echo "Warning: OpenFOAM 2412 not found at $OF_BASHRC"
    echo "The GUI will launch but the solver will not run."
    echo "Install OpenFOAM 2412: https://openfoam.org/download/2412-ubuntu/"
fi

exec "${HERE}/usr/bin/CFDStudio" "$@"
